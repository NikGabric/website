<Layouts.app>
  <div class="">
    <.header>
      Nik Gabrič - Full-stack engineer
      <:subtitle>
        I am a full-stack engineer with experience across the whole stack, from databases & APIs all the way
        to the frontend applications.
      </:subtitle>
      <:actions>
        <.button href={~p"/files/cv.pdf"} download="cv.pdf">Download PDF</.button>
      </:actions>
    </.header>

    <section class="mt-10">
      <h2 class="text-lg font-semibold">Professional experience</h2>
      <ul class="mt-4 space-y-6">
        <li :for={job <- @experience}>
          <.experience_card {job} />
        </li>
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold">Professional skills</h2>
      <div class="mt-4">
        <.list>
          <:item :for={skill <- @skills} title={skill.category}>{skill.items}</:item>
        </.list>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold">Projects</h2>
      <ul class="mt-4 space-y-4">
        <li :for={project <- @projects}>
          <h3 class="font-semibold">{project.title}</h3>
          <p class="text-base-content/80">{project.desc}</p>
        </li>
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold">Education</h2>
      <ul class="mt-4 space-y-4">
        <li :for={school <- @education}>
          <h3 class="font-semibold">{school.title}</h3>
          <p class="text-base-content/80">{school.institution}</p>
          <p :if={school.note} class="mt-1 text-sm text-base-content/60">{school.note}</p>
        </li>
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold">Languages</h2>
      <ul class="mt-4 space-y-1 text-base-content/80">
        <li :for={language <- @languages}>{language.name} — {language.level}</li>
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold">Interests</h2>
      <p class="mt-2 text-base-content/80">
        Cycling, running, hiking, and disc golf. Board games and PC games. Guitar, singing, and going to concerts.
      </p>
    </section>

    <section class="mt-10 mb-16">
      <h2 class="text-lg font-semibold">Contact</h2>
      <ul class="mt-4 space-y-1">
        <li><.link href="mailto:nik.gabric@protonmail.com">nik.gabric@protonmail.com</.link></li>
        <li>
          <.link href="https://www.linkedin.com/in/nik-gabrič" target="_blank">
            linkedin.com/in/nik-gabrič
          </.link>
        </li>
        <li>
          <.link href="https://github.com/NikGabric" target="_blank">github.com/NikGabric</.link>
        </li>
      </ul>
    </section>
  </div>
</Layouts.app>
