<Layouts.app>
  <.header>
    # Nik Gabrič - Full-stack engineer
    <:subtitle>
      I am a full-stack engineer with experience across the whole stack, from databases & APIs all the way
      to the frontend applications.
    </:subtitle>
    <:actions>
      <.button href={~p"/files/cv.pdf"} download="cv.pdf">Download PDF</.button>
    </:actions>
  </.header>

  <.section title="Professional experience">
    <ul class="mt-4 space-y-6">
      <li :for={job <- @experience}>
        <.experience_card {job} />
      </li>
    </ul>
  </.section>

  <.section title="Professional skills">
    <.list>
      <:item :for={skill <- @skills} title={skill.category}>{skill.items}</:item>
    </.list>
  </.section>

  <.section title="Projects">
    <ul class="mt-4 space-y-4">
      <li :for={project <- @projects}>
        <h3 class="font-semibold">{project.title}</h3>
        <p class="text-base-content/80">{project.desc}</p>
      </li>
    </ul>
  </.section>

  <.section title="Education">
    <ul class="mt-4 space-y-4">
      <li :for={school <- @education} class="flex gap-3">
        <.icon name="hero-academic-cap" class="mt-1 size-6 shrink-0 text-base-content/60" />
        <div>
          <h3 class="font-semibold">{school.title}</h3>
          <p class="text-base-content/80">{school.institution}</p>
          <p :if={school.note} class="mt-1 text-sm text-base-content/60">{school.note}</p>
        </div>
      </li>
    </ul>
  </.section>

  <.section title="Contact">
    <ul class="mt-4 space-y-2">
      <li class="flex items-center gap-2">
        <.link href="mailto:nik.gabric@protonmail.com" class="flex gap-2 items-center"><.icon
          name="hero-envelope"
          class="size-4 shrink-0 text-base-content/60"
        /> nik.gabric@protonmail.com</.link>
      </li>
      <li class="flex items-center gap-2">
        <.link
          href="https://www.linkedin.com/in/nik-gabrič"
          target="_blank"
          class="flex gap-2 items-center"
        >
          <.icon name="brand-linkedin" class="size-4 shrink-0 text-base-content/60" />
          /in/nik-gabrič
        </.link>
      </li>
      <li class="flex items-center gap-2">
        <.link href="https://github.com/NikGabric" target="_blank" class="flex gap-2 items-center"><.icon
          name="brand-github"
          class="size-4 shrink-0 text-base-content/60"
        /> github.com/NikGabric</.link>
      </li>
    </ul>
  </.section>
</Layouts.app>
